# Copy file ini jadi "keystore.properties" (tanpa .example) di root project yang sama,
# lalu isi sesuai keystore yang Anda buat lewat tools/generate_keystore.sh.
#
# File "keystore.properties" (dan file .jks/.keystore-nya) SUDAH otomatis di-.gitignore -
# JANGAN pernah commit ke Git, terutama kalau repo Anda publik.
#
# storeFile boleh path relatif dari root project, atau path absolut di komputer Anda.
storeFile=release.keystore
storePassword=ISI_PASSWORD_KEYSTORE_ANDA
keyAlias=nada-pos-release
keyPassword=ISI_PASSWORD_KEY_ANDA
